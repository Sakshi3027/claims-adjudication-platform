    <artifactId>audit</artifactId>

    <!--
        Same reasoning as rules-engine: this module defines what an audit
        event *is* and the contract for recording one, without caring
        whether it ends up in Mongo, Postgres, or a log file. The actual
        Mongo-backed implementation lives in the api module, next to the
        rest of the persistence code.
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
